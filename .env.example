# 对外访问根地址，Docker / 反代时必填，OAuth 回调和获客短链用它
OMNIPOST_BASE_URL=http://localhost:3000

TZ=Asia/Shanghai
OMNIPOST_DRY_RUN=true

# 大模型（也可在「创作台」里绑定，不必写进环境变量）
LLM_API_KEY=
LLM_BASE_URL=
LLM_CHAT_MODEL=

# 微博 https://open.weibo.com
WEIBO_APP_KEY=
WEIBO_APP_SECRET=
WEIBO_ACCESS_TOKEN=

# 微信公众号
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 小红书开放平台
XHS_APP_ID=
XHS_APP_SECRET=
XHS_ACCESS_TOKEN=

# X
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Facebook / Instagram
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
